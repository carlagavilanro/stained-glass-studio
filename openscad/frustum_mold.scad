// Basic stained-glass lampshade frustum mold starter.
// Units: millimeters.
// Export from OpenSCAD as STL or 3MF for a physical mold/form.

bottom_radius = 145;
top_radius = 85;
height = 260;
wall_thickness = 4;
facets = 192;

// Optional preview rings. These are raised visual references, not the source of truth
// for the SVG/DXF glass pattern generated by the web app.
show_reference_lines = true;
radial_segments = 12;
bands = 5;
reference_line_radius = 0.7;
reference_line_height = 0.8;

module frustum_shell() {
  difference() {
    cylinder(h = height, r1 = bottom_radius, r2 = top_radius, $fn = facets);
    translate([0, 0, -0.1])
      cylinder(
        h = height + 0.2,
        r1 = max(bottom_radius - wall_thickness, 0.1),
        r2 = max(top_radius - wall_thickness, 0.1),
        $fn = facets
      );
  }
}

module reference_ring(z) {
  radius = bottom_radius + (top_radius - bottom_radius) * (z / height);
  translate([0, 0, z])
    rotate_extrude($fn = facets)
      translate([radius, 0, 0])
        circle(r = reference_line_radius, $fn = 12);
}

module reference_vertical(theta) {
  // A simple raised vertical guide approximated with small cylinders.
  samples = 32;
  for (i = [0 : samples - 1]) {
    z0 = height * i / samples;
    z1 = height * (i + 1) / samples;
    zm = (z0 + z1) / 2;
    radius = bottom_radius + (top_radius - bottom_radius) * (zm / height);
    segment_h = (z1 - z0) + 0.2;

    translate([radius * cos(theta), radius * sin(theta), zm])
      rotate([90, 0, theta])
        cylinder(h = segment_h, r = reference_line_radius, center = true, $fn = 8);
  }
}

frustum_shell();

if (show_reference_lines) {
  for (band = [0 : bands]) {
    reference_ring(height * band / bands);
  }
  for (segment = [0 : radial_segments - 1]) {
    reference_vertical(360 * segment / radial_segments);
  }
}
